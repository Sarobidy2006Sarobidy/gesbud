<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="background-page" xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.budgetmanager.controller.CarnetController">

    <left>
        <fx:include fx:id="sidebar" source="sidebar.fxml"/>
    </left>

    <center>
        <ScrollPane fitToWidth="true" styleClass="page-scroll">
            <VBox spacing="18" styleClass="page-content">

                <!-- ===== En-tête ===== -->
                <HBox alignment="CENTER_LEFT" spacing="14">
                    <VBox spacing="3" HBox.hgrow="ALWAYS">
                        <Label text="Emprunts &amp; prêts" styleClass="page-title"/>
                        <Label text="Le carnet de ce que vous devez et de ce qu'on vous doit"
                               wrapText="true" maxWidth="560" styleClass="page-subtitle"/>
                    </VBox>
                    <VBox spacing="1" alignment="CENTER_RIGHT" styleClass="chip-droite">
                        <Label text="DANS LE CARNET" styleClass="chip-label"/>
                        <Label fx:id="labelNombre" text="0" styleClass="chip-value"/>
                    </VBox>
                </HBox>

                <!-- Le cadre est indépendant : l'énoncer évite qu'on y cherche un total du budget. -->
                <Label wrapText="true" styleClass="carnet-note"
                       text="Ce carnet est indépendant : aucun de ces montants n'entre dans vos revenus, vos dépenses, vos économies ni votre solde. Il note une situation, il ne déplace pas d'argent."/>

                <!-- ===== Indicateurs ===== -->
                <GridPane fx:id="grilleCartes" hgap="16" vgap="16">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50"/>
                        <ColumnConstraints percentWidth="50"/>
                    </columnConstraints>

                    <VBox styleClass="kpi-card, kpi-jour" spacing="6"
                          GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label text="DOSSIERS EN COURS" styleClass="kpi-label"/>
                        <Label fx:id="labelEnCours" text="0" styleClass="kpi-value"/>
                        <Label text="À suivre, rien n'est calculé pour vous" styleClass="kpi-detail"/>
                    </VBox>
                    <VBox styleClass="kpi-card, kpi-revenus" spacing="6"
                          GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label text="DOSSIERS RÉGLÉS" styleClass="kpi-label"/>
                        <Label fx:id="labelRegles" text="0" styleClass="kpi-value"/>
                        <Label text="Vous cochez « Réglé » quand c'est rendu" styleClass="kpi-detail"/>
                    </VBox>
                </GridPane>

                <!-- ===== Formulaire ===== -->
                <VBox styleClass="form-card" spacing="14">
                    <VBox spacing="2">
                        <Label text="Ajouter / Modifier une écriture" styleClass="form-card-title"/>
                        <Label text="Sélectionnez une ligne du tableau pour la modifier."
                               styleClass="form-card-sub"/>
                    </VBox>

                    <HBox spacing="12">
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Sens" styleClass="form-label"/>
                            <ComboBox fx:id="comboSens" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Statut" styleClass="form-label"/>
                            <ComboBox fx:id="comboStatut" maxWidth="Infinity"/>
                        </VBox>
                    </HBox>

                    <HBox spacing="12">
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Avec qui" styleClass="form-label"/>
                            <TextField fx:id="champPersonne" promptText="ex. : Rakoto, la banque, un frère"/>
                        </VBox>
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Pour quoi (facultatif)" styleClass="form-label"/>
                            <TextField fx:id="champMotif" promptText="ex. : réparation moteur"/>
                        </VBox>
                    </HBox>

                    <HBox spacing="12">
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Montant" styleClass="form-label"/>
                            <TextField fx:id="champMontant" promptText="0"/>
                        </VBox>
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="La date" styleClass="form-label"/>
                            <DatePicker fx:id="champDateDebut" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="À rendre le (facultatif)" styleClass="form-label"/>
                            <DatePicker fx:id="champDateFin" maxWidth="Infinity"/>
                        </VBox>
                    </HBox>

                    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="form-actions">
                        <Button fx:id="boutonAjouter" text="Ajouter" styleClass="button-primary" onAction="#ajouterEcriture" contentDisplay="LEFT"/>
                        <Button fx:id="boutonModifier" text="Modifier" styleClass="button-secondary" onAction="#modifierEcriture" contentDisplay="LEFT"/>
                        <Button fx:id="boutonSupprimer" text="Supprimer" styleClass="button-danger" onAction="#supprimerEcriture" contentDisplay="LEFT"/>
                    </HBox>
                </VBox>

                <!-- ===== Filtres ===== -->
                <VBox styleClass="form-card" spacing="14">
                    <VBox spacing="2">
                        <Label text="Filtrer le carnet" styleClass="form-card-title"/>
                        <Label text="Le filtrage se fait sur les écritures déjà chargées."
                               styleClass="form-card-sub"/>
                    </VBox>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Type" styleClass="form-label"/>
                            <ComboBox fx:id="comboFiltreSens" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Nom ou motif" styleClass="form-label"/>
                            <TextField fx:id="champRecherche" promptText="Rechercher une personne, un motif"/>
                        </VBox>
                        <VBox spacing="5">
                            <Label text=" " styleClass="form-label"/>
                            <HBox spacing="10">
                                <Button fx:id="boutonFiltrer" minWidth="-Infinity" text="Filtrer" styleClass="button-primary" onAction="#rechercherEtFiltrer" contentDisplay="LEFT"/>
                                <Button fx:id="boutonReinitialiser" minWidth="-Infinity" text="Réinitialiser" styleClass="button-secondary" onAction="#reinitialiserFiltres" contentDisplay="LEFT"/>
                            </HBox>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- ===== Tableau ===== -->
                <VBox styleClass="table-card" spacing="10" VBox.vgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="Vos écritures" styleClass="table-card-title"/>
                        <Label fx:id="pastilleNombre" text="0" styleClass="pill-count"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="Tri en cliquant sur un en-tête de colonne" styleClass="form-card-sub"/>
                    </HBox>
                    <TableView fx:id="tableCarnet" styleClass="table-embed" VBox.vgrow="ALWAYS" minHeight="200">
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="colonneSens" text="Sens" prefWidth="130" minWidth="110"/>
                            <TableColumn fx:id="colonnePersonne" text="Avec qui" prefWidth="180" minWidth="120"/>
                            <TableColumn fx:id="colonneMotif" text="Pour quoi" prefWidth="240"/>
                            <TableColumn fx:id="colonneMontant" text="Montant" prefWidth="150" minWidth="120"/>
                            <TableColumn fx:id="colonneDateDebut" text="La date" prefWidth="120" minWidth="95"/>
                            <TableColumn fx:id="colonneDateFin" text="À rendre le" prefWidth="120" minWidth="95"/>
                            <TableColumn fx:id="colonneStatut" text="Statut" prefWidth="120" minWidth="100"/>
                        </columns>
                    </TableView>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
