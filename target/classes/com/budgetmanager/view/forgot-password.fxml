<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="racine" styleClass="auth-container" xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.budgetmanager.controller.ForgotPasswordController">
    <HBox>
        <fx:include source="auth-hero.fxml" HBox.hgrow="ALWAYS"/>

        <StackPane styleClass="auth-side" minWidth="500" prefWidth="500" maxWidth="500">
            <VBox styleClass="auth-card" spacing="16" maxWidth="420" maxHeight="-Infinity">

                <HBox alignment="CENTER_LEFT" spacing="12">
                    <StackPane fx:id="zoneLogo"/>
                    <Label text="BUDGET PERSONNEL" styleClass="auth-brand"/>
                </HBox>

                <VBox spacing="3">
                    <Label text="Mot de passe oublié" styleClass="auth-title"/>
                    <Label text="Répondez à votre question de sécurité pour choisir un nouveau mot de passe"
                           styleClass="auth-tagline" wrapText="true"/>
                </VBox>

                <!-- Indicateur des 3 étapes -->
                <HBox alignment="CENTER" spacing="8">
                    <Label fx:id="pastille1" text="1" styleClass="auth-step"/>
                    <Region styleClass="auth-step-line" HBox.hgrow="ALWAYS"/>
                    <Label fx:id="pastille2" text="2" styleClass="auth-step"/>
                    <Region styleClass="auth-step-line" HBox.hgrow="ALWAYS"/>
                    <Label fx:id="pastille3" text="3" styleClass="auth-step"/>
                </HBox>

                <Label fx:id="labelMessage" styleClass="auth-message" wrapText="true" maxWidth="Infinity"/>

                <!-- Étape 1 : email -->
                <VBox fx:id="panneauEmail" spacing="14">
                    <Label text="Saisissez le pseudo ou l'adresse email de votre compte." styleClass="auth-step-hint" wrapText="true"/>
                    <HBox styleClass="auth-input" alignment="CENTER_LEFT">
                        <StackPane fx:id="zoneIconeEmail" styleClass="auth-input-icon"/>
                        <TextField fx:id="champEmail" styleClass="auth-textfield" promptText="Pseudo ou adresse email"
                                   HBox.hgrow="ALWAYS" onAction="#continuer"/>
                    </HBox>
                    <Button fx:id="boutonContinuer" text="CONTINUER" styleClass="auth-button" maxWidth="Infinity"
                            onAction="#continuer"/>
                </VBox>

                <!-- Étape 2 : question de sécurité -->
                <VBox fx:id="panneauQuestion" spacing="14">
                    <Label text="Votre question de sécurité" styleClass="auth-step-hint"/>
                    <Label fx:id="labelQuestion" styleClass="auth-question" wrapText="true" maxWidth="Infinity"/>
                    <HBox styleClass="auth-input" alignment="CENTER_LEFT">
                        <StackPane fx:id="zoneIconeReponse" styleClass="auth-input-icon"/>
                        <TextField fx:id="champReponse" styleClass="auth-textfield" promptText="Votre réponse"
                                   HBox.hgrow="ALWAYS" onAction="#verifierReponse"/>
                    </HBox>
                    <Button fx:id="boutonVerifier" text="VÉRIFIER MA RÉPONSE" styleClass="auth-button" maxWidth="Infinity"
                            onAction="#verifierReponse"/>
                </VBox>

                <!-- Étape 3 : nouveau mot de passe -->
                <VBox fx:id="panneauMotDePasse" spacing="14">
                    <Label text="Choisissez votre nouveau mot de passe (8 caractères minimum)." styleClass="auth-step-hint" wrapText="true"/>
                    <HBox styleClass="auth-input" alignment="CENTER_LEFT">
                        <StackPane fx:id="zoneIconeNouveau" styleClass="auth-input-icon"/>
                        <PasswordField fx:id="champNouveauMotDePasse" styleClass="auth-textfield"
                                       promptText="Nouveau mot de passe" HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <HBox styleClass="auth-input" alignment="CENTER_LEFT">
                        <StackPane fx:id="zoneIconeConfirmation" styleClass="auth-input-icon"/>
                        <PasswordField fx:id="champConfirmation" styleClass="auth-textfield"
                                       promptText="Confirmer le mot de passe" HBox.hgrow="ALWAYS"
                                       onAction="#enregistrerNouveauMotDePasse"/>
                    </HBox>
                    <Button fx:id="boutonEnregistrer" text="CHANGER LE MOT DE PASSE" styleClass="auth-button"
                            maxWidth="Infinity" onAction="#enregistrerNouveauMotDePasse"/>
                </VBox>

                <Separator styleClass="auth-separator"/>

                <HBox alignment="CENTER">
                    <Hyperlink fx:id="lienRetour" text="Retour à la connexion" styleClass="auth-link-strong"
                               onAction="#allerVersConnexion"/>
                </HBox>
            </VBox>
        </StackPane>
    </HBox>
</StackPane>
