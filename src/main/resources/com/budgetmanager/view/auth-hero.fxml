<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Panneau décoratif de gauche des écrans d'authentification : badges hexagonaux
     flottants (dessinés en Java par AuthHeroController) + accroche. -->
<StackPane styleClass="auth-hero" xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.budgetmanager.controller.AuthHeroController">
    <Pane fx:id="zoneHexagones" mouseTransparent="true"/>
    <VBox styleClass="auth-hero-text" alignment="BOTTOM_LEFT" spacing="8" pickOnBounds="false">
        <Label text="Gardez le contrôle de votre budget" styleClass="auth-hero-title" wrapText="true"/>
        <Label text="Revenus, dépenses, catégories et statistiques : tout votre suivi financier au même endroit."
               styleClass="auth-hero-subtitle" wrapText="true"/>
    </VBox>
</StackPane>
