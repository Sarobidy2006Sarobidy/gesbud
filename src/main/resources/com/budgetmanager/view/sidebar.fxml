<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="sidebar" spacing="3" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.budgetmanager.controller.SidebarController">

    <HBox styleClass="sidebar-brand" alignment="CENTER_LEFT" spacing="10">
        <StackPane fx:id="zoneLogo" styleClass="sidebar-brand-logo"/>
        <VBox spacing="1">
            <Label text="Mon budget" styleClass="sidebar-brand-name"/>
            <Label fx:id="labelSousTitre" text="Gestion personnelle" styleClass="sidebar-brand-sub"/>
        </VBox>
    </HBox>

    <Label text="Pilotage" styleClass="sidebar-group"/>
    <Button fx:id="boutonDashboard" styleClass="nav-item" text="Tableau de bord"
            maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#allerVersDashboard"/>

    <Label text="Opérations" styleClass="sidebar-group"/>
    <Button fx:id="boutonRevenus" styleClass="nav-item" text="Revenus"
            maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#allerVersRevenus"/>
    <Button fx:id="boutonDepenses" styleClass="nav-item" text="Dépenses"
            maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#allerVersDepenses"/>
    <Button fx:id="boutonEconomies" styleClass="nav-item" text="Économies"
            maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#allerVersEconomies"/>

    <Label text="Suivi" styleClass="sidebar-group"/>
    <Button fx:id="boutonCategories" styleClass="nav-item" text="Catégories"
            maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#allerVersCategories"/>
    <Button fx:id="boutonHistorique" styleClass="nav-item" text="Historique"
            maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#allerVersHistorique"/>
    <Button fx:id="boutonCarnet" styleClass="nav-item" text="Emprunts &amp; prêts"
            maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#allerVersCarnet"/>

    <Label text="Système" styleClass="sidebar-group"/>
    <Button fx:id="boutonParametres" styleClass="nav-item" text="Paramètres"
            maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#allerVersParametres"/>

    <Region VBox.vgrow="ALWAYS"/>

    <Button fx:id="boutonDeconnexion" styleClass="nav-item,nav-item-logout" text="Déconnexion"
            maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#seDeconnecter"/>
</VBox>
