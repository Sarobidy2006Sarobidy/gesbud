<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="background-page" xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.budgetmanager.controller.ExpenseController">

    <left>
        <fx:include fx:id="sidebar" source="sidebar.fxml"/>
    </left>

    <center>
        <StackPane>
            <ScrollPane fitToWidth="true" styleClass="page-scroll">
            <VBox spacing="16" styleClass="page-content">
                <Label text="Gestion des dépenses" styleClass="page-title"/>

                <VBox styleClass="card" spacing="12">
                    <Label text="Ajouter / Modifier une dépense" styleClass="card-title"/>
                    <HBox spacing="12">
                        <TextField fx:id="champMontant" promptText="Montant" HBox.hgrow="ALWAYS"/>
                        <ComboBox fx:id="comboCategorie" promptText="Catégorie" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <DatePicker fx:id="champDate" promptText="Date (début)" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    </HBox>
                    <TextField fx:id="champDescription" promptText="Description"/>
                    <HBox spacing="12">
                        <ComboBox fx:id="comboFrequence" promptText="Fréquence" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <DatePicker fx:id="champDateFin" promptText="Jusqu'au (facultatif)" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    </HBox>
                    <Label fx:id="labelAideFrequence" styleClass="page-subtitle" wrapText="true"/>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Button fx:id="boutonAjouter" text="Ajouter" styleClass="button-primary" onAction="#ajouterDepense" contentDisplay="LEFT"/>
                        <Button fx:id="boutonModifier" text="Modifier" styleClass="button-secondary" onAction="#modifierDepense" contentDisplay="LEFT"/>
                        <Button fx:id="boutonSupprimer" text="Supprimer" styleClass="button-danger" onAction="#supprimerDepense" contentDisplay="LEFT"/>
                        <ProgressIndicator fx:id="indicateurChargement" prefWidth="24" prefHeight="24" visible="false"/>
                    </HBox>
                </VBox>

                <VBox styleClass="card" spacing="12">
                    <Label text="Rechercher et filtrer" styleClass="card-title"/>
                    <HBox spacing="12">
                        <TextField fx:id="champRecherche" promptText="Rechercher une description" HBox.hgrow="ALWAYS"/>
                        <ComboBox fx:id="comboFiltreCategorie" promptText="Catégorie" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <HBox spacing="12">
                        <DatePicker fx:id="champFiltreDateDebut" promptText="Du" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                        <DatePicker fx:id="champFiltreDateFin" promptText="Au" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                        <Button fx:id="boutonFiltrer" minWidth="-Infinity" text="Filtrer" styleClass="button-primary" onAction="#rechercherEtFiltrer" contentDisplay="LEFT"/>
                        <Button fx:id="boutonReinitialiser" minWidth="-Infinity" text="Réinitialiser" styleClass="button-secondary" onAction="#reinitialiserFiltres" contentDisplay="LEFT"/>
                    </HBox>
                </VBox>

                <TableView fx:id="tableDepenses" VBox.vgrow="ALWAYS">
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colonneCategorie" text="Catégorie" prefWidth="150"/>
                        <TableColumn fx:id="colonneMontant" text="Montant" prefWidth="120"/>
                        <TableColumn fx:id="colonneDescription" text="Description" prefWidth="250"/>
                        <TableColumn fx:id="colonneDate" text="Date" prefWidth="120"/>
                        <TableColumn fx:id="colonneFrequence" text="Fréquence" prefWidth="170"/>
                    </columns>
                </TableView>
            </VBox>
            </ScrollPane>

            <!-- Overlay de chargement -->
            <VBox fx:id="overlayChargement" alignment="CENTER" spacing="12"
                  visible="false" managed="false"
                  style="-fx-background-color: rgba(243,247,253,0.82);
                         -fx-background-radius: 12;">
                <ProgressIndicator prefWidth="48" prefHeight="48"/>
                <Label text="Chargement des dépenses…" styleClass="page-subtitle"/>
            </VBox>
        </StackPane>
    </center>
</BorderPane>
