<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- ================================================================
         Logback — Configuration du journal de l'application.

         Deux destinations :
         1. Console (développement) : toutes les traces niveau INFO+
         2. Fichier budget-app.log (production) : toutes les erreurs,
            avec rotation automatique quand le fichier dépasse 5 Mo.
            Le fichier est écrit dans le répertoire de travail courant.
         ================================================================ -->

    <!-- Format lisible : date heure [thread] NIVEAU logger - message -->
    <property name="PATTERN" value="%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n"/>

    <!-- Console (IDE / développement) -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- Fichier tournant (production) -->
    <appender name="FICHIER" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>budget-app.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- budget-app.2024-01-15.1.log.gz -->
            <fileNamePattern>budget-app.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>5MB</maxFileSize>
            <!-- Garder 30 jours de logs maximum -->
            <maxHistory>30</maxHistory>
            <totalSizeCap>50MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- Niveau racine : INFO en console, ERROR dans le fichier -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

    <!-- Logs de l'application : DEBUG en développement, ERROR en production -->
    <logger name="com.budgetmanager" level="DEBUG" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FICHIER"/>
    </logger>

    <!-- HikariCP : seulement les avertissements (évite le bruit) -->
    <logger name="com.zaxxer.hikari" level="WARN"/>

</configuration>
