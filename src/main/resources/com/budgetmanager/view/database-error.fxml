<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.budgetmanager.controller.DatabaseErrorController"
           styleClass="auth-container">

    <VBox alignment="CENTER" spacing="24" maxWidth="520"
          styleClass="auth-card" style="-fx-padding: 48 40 48 40;">

        <!-- Icône erreur -->
        <StackPane fx:id="iconeErreur" alignment="CENTER"
                   style="-fx-background-color: #fff0f0; -fx-background-radius: 50%;
                          -fx-min-width: 80; -fx-min-height: 80;"/>

        <!-- Titre -->
        <Label fx:id="labelTitre" text="Base de données inaccessible"
               styleClass="auth-title" wrapText="true" alignment="CENTER"/>

        <!-- Explication principale -->
        <Label fx:id="labelDetail"
               wrapText="true" alignment="CENTER"
               style="-fx-text-fill: #5b7099; -fx-font-size: 13px;"
               maxWidth="440"/>

        <!-- Port configuré -->
        <Label fx:id="labelPort"
               wrapText="true" alignment="CENTER"
               style="-fx-text-fill: #d92d20; -fx-font-size: 12px; -fx-font-family: 'Inter';"
               maxWidth="440"/>

        <!-- Guide rapide -->
        <VBox spacing="6" style="-fx-background-color: #f3f7fd; -fx-background-radius: 10;
                                  -fx-padding: 14 18 14 18;">
            <Label text="Comment résoudre ce problème :"
                   style="-fx-font-weight: bold; -fx-text-fill: #0f2a5c;"/>
            <Label text="1. Ouvrez le panneau de contrôle XAMPP ou WampServer"
                   style="-fx-text-fill: #35508a;" wrapText="true"/>
            <Label text="2. Démarrez le service MySQL (bouton Start)"
                   style="-fx-text-fill: #35508a;" wrapText="true"/>
            <Label text="3. Si le port affiché est 3307, modifiez db.url dans database.properties"
                   style="-fx-text-fill: #35508a;" wrapText="true"/>
            <Label text="4. Cliquez sur « Réessayer » ci-dessous"
                   style="-fx-text-fill: #35508a;" wrapText="true"/>
        </VBox>

        <!-- Statut de la tentative -->
        <Label fx:id="labelStatut"
               wrapText="true" alignment="CENTER"
               style="-fx-text-fill: #1565c0; -fx-font-size: 12px;"
               maxWidth="440"/>

        <!-- Boutons -->
        <HBox spacing="12" alignment="CENTER">
            <Button fx:id="boutonReessayer" text="Réessayer"
                    styleClass="button-primary" onAction="#reessayer"
                    style="-fx-min-width: 140;"/>
            <Button fx:id="boutonQuitter" text="Quitter"
                    styleClass="button-danger" onAction="#quitter"
                    style="-fx-min-width: 120;"/>
        </HBox>

    </VBox>
</StackPane>
