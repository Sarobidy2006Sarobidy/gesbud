<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.AreaChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="background-page" xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.budgetmanager.controller.SavingsController">

    <left>
        <fx:include fx:id="sidebar" source="sidebar.fxml"/>
    </left>

    <center>
        <ScrollPane fx:id="pageScrollPane" fitToWidth="true" styleClass="page-scroll">
            <VBox fx:id="pageContent" spacing="18" styleClass="page-content">

                <!-- ===== En-tête ===== -->
                <HBox alignment="CENTER_LEFT" spacing="14">
                    <VBox spacing="3" HBox.hgrow="ALWAYS">
                        <Label text="Mes économies" styleClass="page-title"/>
                        <Label text="Ce que vous mettez de côté, et ce que vous en reprenez"
                               wrapText="true" maxWidth="560" styleClass="page-subtitle"/>
                    </VBox>
                    <VBox spacing="1" alignment="CENTER_RIGHT" styleClass="chip-droite">
                        <Label text="DANS LA TIRELIRE" styleClass="chip-label"/>
                        <Label fx:id="labelTotal" text="0" styleClass="chip-value"/>
                    </VBox>
                </HBox>

                <Label fx:id="labelAlerteSolde" visible="false" managed="false" wrapText="true"
                       styleClass="hero-alerte"/>

                <!-- ===== Indicateurs ===== -->
                <GridPane fx:id="grilleCartes" hgap="16" vgap="16">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50"/>
                        <ColumnConstraints percentWidth="50"/>
                    </columnConstraints>

                    <VBox styleClass="kpi-card, kpi-economies" spacing="6"
                          GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label text="CE MOIS-CI" styleClass="kpi-label"/>
                        <Label fx:id="labelMois" text="0" styleClass="kpi-value"/>
                        <Label text="Dépôts moins retraits" styleClass="kpi-detail"/>
                    </VBox>
                    <VBox styleClass="kpi-card, kpi-solde" spacing="6"
                          GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label text="DÉPÔTS ET RETRAITS" styleClass="kpi-label"/>
                        <Label fx:id="labelNombre" text="0" styleClass="kpi-value"/>
                        <Label fx:id="labelDetailMouvements" text="—" styleClass="kpi-detail"/>
                    </VBox>
                </GridPane>

                <!-- ===== Courbe ===== -->
                <VBox styleClass="chart-card" spacing="8">
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <VBox spacing="2" HBox.hgrow="ALWAYS">
                            <Label text="Évolution des économies" styleClass="table-card-title"/>
                            <Label text="Ce qu'il reste dans la tirelire, période après période" styleClass="form-card-sub"/>
                        </VBox>
                        <VBox spacing="4" alignment="TOP_RIGHT">
                            <Label text="Période" styleClass="field-caption"/>
                            <ComboBox fx:id="comboPeriode" styleClass="period-select" prefWidth="150"/>
                        </VBox>
                    </HBox>
                    <AreaChart fx:id="courbeEconomies" styleClass="courbe-solde"
                               prefHeight="280" VBox.vgrow="ALWAYS">
                        <xAxis><CategoryAxis/></xAxis>
                        <yAxis><NumberAxis/></yAxis>
                    </AreaChart>
                </VBox>

                <!-- ===== Formulaire ===== -->
                <VBox fx:id="formulaireEconomie" styleClass="form-card" spacing="14">
                    <VBox spacing="2">
                        <Label text="Ajouter / Modifier une économie" styleClass="form-card-title"/>
                        <Label text="Sélectionnez une ligne du tableau pour la modifier."
                               styleClass="form-card-sub"/>
                    </VBox>

                    <HBox spacing="12">
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Montant" styleClass="form-label"/>
                            <TextField fx:id="champMontant" promptText="0"/>
                        </VBox>
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Date" styleClass="form-label"/>
                            <DatePicker fx:id="champDate" maxWidth="Infinity"/>
                        </VBox>
                    </HBox>

                    <VBox spacing="5">
                        <Label text="Description" styleClass="form-label"/>
                        <TextField fx:id="champDescription" promptText="ex. : projet, urgence, voyage"/>
                    </VBox>

                    <HBox spacing="12">
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Fréquence" styleClass="form-label"/>
                            <ComboBox fx:id="comboFrequence" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Jusqu'au (facultatif)" styleClass="form-label"/>
                            <DatePicker fx:id="champDateFin" maxWidth="Infinity"/>
                        </VBox>
                    </HBox>

                    <Label fx:id="labelAideFrequence" styleClass="page-subtitle" wrapText="true"/>

                    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="form-actions">
                        <Button fx:id="boutonAjouter" text="Ajouter" styleClass="button-primary" onAction="#ajouterEconomie" contentDisplay="LEFT"/>
                        <Button fx:id="boutonModifier" text="Modifier" styleClass="button-secondary" onAction="#modifierEconomie" contentDisplay="LEFT"/>
                        <Button fx:id="boutonSupprimer" text="Supprimer" styleClass="button-danger" onAction="#supprimerEconomie" contentDisplay="LEFT"/>
                    </HBox>
                </VBox>

                <!-- ===== Retrait d'épargne ===== -->
                <VBox fx:id="formulaireRetrait" styleClass="form-card, sortie-card" spacing="14">
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <StackPane fx:id="sortiePuce" styleClass="sortie-puce"/>
                        <VBox spacing="2" HBox.hgrow="ALWAYS">
                            <Label text="Retirer de ma tirelire" styleClass="form-card-title"/>
                            <Label text="L'argent repris retourne dans votre solde disponible : vous le dépensez ensuite comme d'habitude."
                                   wrapText="true" maxWidth="620" styleClass="form-card-sub"/>
                        </VBox>
                        <VBox spacing="1" alignment="CENTER_RIGHT">
                            <Label text="DANS LA TIRELIRE" styleClass="chip-label"/>
                            <Label fx:id="labelTirelire" text="0" styleClass="chip-value"/>
                        </VBox>
                    </HBox>

                    <HBox spacing="12">
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Montant retiré" styleClass="form-label"/>
                            <TextField fx:id="champRetraitMontant" promptText="0"/>
                        </VBox>
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Date du retrait" styleClass="form-label"/>
                            <DatePicker fx:id="champRetraitDate" maxWidth="Infinity"/>
                        </VBox>
                    </HBox>

                    <VBox spacing="5">
                        <Label text="Pour quoi (facultatif)" styleClass="form-label"/>
                        <TextField fx:id="champRetraitMotif" promptText="ex. : achat voiture, réparation, fête"/>
                    </VBox>

                    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="form-actions">
                        <Button fx:id="boutonRetirer" text="Retirer" styleClass="button-sortie"
                                onAction="#retirerEconomie" contentDisplay="LEFT"/>
                        <Label fx:id="labelApresRetrait" wrapText="true" styleClass="sortie-apres"/>
                    </HBox>
                </VBox>

                <!-- ===== Filtres ===== -->
                <VBox styleClass="form-card" spacing="14">
                    <VBox spacing="2">
                        <Label text="Rechercher et filtrer" styleClass="form-card-title"/>
                        <Label text="Le filtrage se fait sur les opérations déjà chargées."
                               styleClass="form-card-sub"/>
                    </VBox>
                    <VBox spacing="5">
                        <Label text="Description" styleClass="form-label"/>
                        <TextField fx:id="champRecherche" promptText="Rechercher une description"/>
                    </VBox>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Du" styleClass="form-label"/>
                            <DatePicker fx:id="champFiltreDateDebut" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Au" styleClass="form-label"/>
                            <DatePicker fx:id="champFiltreDateFin" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="5">
                            <Label text=" " styleClass="form-label"/>
                            <HBox spacing="10">
                                <Button fx:id="boutonFiltrer" minWidth="-Infinity" text="Filtrer" styleClass="button-primary" onAction="#rechercherEtFiltrer" contentDisplay="LEFT"/>
                                <Button fx:id="boutonReinitialiser" minWidth="-Infinity" text="Réinitialiser" styleClass="button-secondary" onAction="#reinitialiserFiltres" contentDisplay="LEFT"/>
                            </HBox>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- ===== Tableau ===== -->
                <VBox styleClass="table-card" spacing="10" VBox.vgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="Vos économies" styleClass="table-card-title"/>
                        <Label fx:id="pastilleNombre" text="0" styleClass="pill-count"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="Tri en cliquant sur un en-tête de colonne" styleClass="form-card-sub"/>
                    </HBox>
                    <TableView fx:id="tableEconomies" styleClass="table-embed" VBox.vgrow="ALWAYS" minHeight="200">
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="colonneMontant" text="Montant" prefWidth="140" minWidth="130"/>
                            <TableColumn fx:id="colonneDescription" text="Description" prefWidth="300"/>
                            <TableColumn fx:id="colonneDate" text="Date" prefWidth="130" minWidth="95"/>
                            <TableColumn fx:id="colonneFrequence" text="Fréquence" prefWidth="170" minWidth="110"/>
                        </columns>
                    </TableView>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
