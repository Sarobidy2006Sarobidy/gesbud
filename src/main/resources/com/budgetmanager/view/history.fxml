<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="background-page" xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.budgetmanager.controller.HistoryController">

    <left>
        <fx:include fx:id="sidebar" source="sidebar.fxml"/>
    </left>

    <center>
        <VBox spacing="18" styleClass="page-content, page-content-flat">

            <!-- ===== En-tête ===== -->
            <HBox alignment="CENTER_LEFT" spacing="14">
                <VBox spacing="3" HBox.hgrow="ALWAYS">
                    <Label text="Historique des opérations" styleClass="page-title"/>
                    <Label text="Revenus, dépenses et économies réunis sur une seule ligne de temps"
                           wrapText="true" maxWidth="620" styleClass="page-subtitle"/>
                </VBox>
                <VBox spacing="1" alignment="CENTER_RIGHT" styleClass="chip-droite">
                    <Label text="OPÉRATIONS" styleClass="chip-label"/>
                    <Label fx:id="pastilleNombre" text="0" styleClass="chip-value"/>
                </VBox>
            </HBox>

            <!-- ===== Filtres ===== -->
            <VBox styleClass="form-card" spacing="14">
                <VBox spacing="2">
                    <Label text="Rechercher, trier et filtrer" styleClass="form-card-title"/>
                    <Label text="Les critères se combinent entre eux." styleClass="form-card-sub"/>
                </VBox>
                <HBox spacing="12">
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="Description" styleClass="form-label"/>
                        <TextField fx:id="champRecherche" promptText="Rechercher une description"/>
                    </VBox>
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="Type" styleClass="form-label"/>
                        <ComboBox fx:id="comboFiltreType" promptText="Tous" maxWidth="Infinity"/>
                    </VBox>
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="Catégorie" styleClass="form-label"/>
                        <ComboBox fx:id="comboFiltreCategorie" promptText="Toutes" maxWidth="Infinity"/>
                    </VBox>
                </HBox>
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="Du" styleClass="form-label"/>
                        <DatePicker fx:id="champFiltreDateDebut" maxWidth="Infinity"/>
                    </VBox>
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="Au" styleClass="form-label"/>
                        <DatePicker fx:id="champFiltreDateFin" maxWidth="Infinity"/>
                    </VBox>
                    <VBox spacing="5">
                        <Label text=" " styleClass="form-label"/>
                        <HBox spacing="10">
                            <Button fx:id="boutonFiltrer" minWidth="-Infinity" text="Filtrer" styleClass="button-primary" onAction="#rechercherEtFiltrer" contentDisplay="LEFT"/>
                            <Button fx:id="boutonReinitialiser" minWidth="-Infinity" text="Réinitialiser" styleClass="button-secondary" onAction="#reinitialiserFiltres" contentDisplay="LEFT"/>
                        </HBox>
                    </VBox>
                </HBox>
            </VBox>

            <!-- ===== Tableau + pagination ===== -->
            <VBox styleClass="table-card" spacing="10" VBox.vgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="Journal des opérations" styleClass="table-card-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="Tri en cliquant sur un en-tête de colonne" styleClass="form-card-sub"/>
                </HBox>
                <TableView fx:id="tableHistorique" styleClass="table-embed" VBox.vgrow="ALWAYS" minHeight="260">
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colonneType" text="Type" prefWidth="90" minWidth="85"/>
                        <TableColumn fx:id="colonneCategorie" text="Catégorie" prefWidth="150"/>
                        <TableColumn fx:id="colonneMontant" text="Montant" prefWidth="130" minWidth="130"/>
                        <TableColumn fx:id="colonneDescription" text="Description" prefWidth="250"/>
                        <TableColumn fx:id="colonneDate" text="Date" prefWidth="110" minWidth="95"/>
                    </columns>
                </TableView>

                <HBox alignment="CENTER_LEFT" spacing="10" styleClass="pagination-bar">
                    <Label fx:id="labelPagination" styleClass="form-card-sub"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="boutonPremiere" text="«" styleClass="bouton-page" onAction="#allerPremierePage" minWidth="36"/>
                    <Button fx:id="boutonPrecedente" text="‹" styleClass="bouton-page" onAction="#allerPagePrecedente" minWidth="36"/>
                    <Button fx:id="boutonSuivante" text="›" styleClass="bouton-page" onAction="#allerPageSuivante" minWidth="36"/>
                    <Button fx:id="boutonDerniere" text="»" styleClass="bouton-page" onAction="#allerDernierePage" minWidth="36"/>
                </HBox>
            </VBox>

        </VBox>
    </center>
</BorderPane>
