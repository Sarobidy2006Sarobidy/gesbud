<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="background-page" xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.budgetmanager.controller.CategoryController">

    <left>
        <fx:include fx:id="sidebar" source="sidebar.fxml"/>
    </left>

    <center>
        <VBox spacing="18" styleClass="page-content, page-content-flat">

            <!-- ===== En-tête ===== -->
            <HBox alignment="CENTER_LEFT" spacing="14">
                <VBox spacing="3" HBox.hgrow="ALWAYS">
                    <Label text="Gestion des catégories" styleClass="page-title"/>
                    <Label text="Elles classent vos revenus et vos dépenses. Tout se joue dans le tableau."
                           wrapText="true" maxWidth="620" styleClass="page-subtitle"/>
                </VBox>
                <VBox spacing="1" alignment="CENTER_RIGHT" styleClass="chip-droite">
                    <Label text="CATÉGORIES" styleClass="chip-label"/>
                    <Label fx:id="pastilleNombre" text="0" styleClass="chip-value"/>
                </VBox>
            </HBox>

            <!-- ===== Recherche ===== -->
            <HBox spacing="12" alignment="CENTER_LEFT">
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Rechercher" styleClass="form-label"/>
                    <TextField fx:id="champRecherche" promptText="Filtrer les catégories affichées (Échap pour effacer)"/>
                </VBox>
            </HBox>

            <!-- ===== Tableau : ajout, modification et suppression s'y font en direct ===== -->
            <VBox styleClass="table-card" spacing="10" VBox.vgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="Vos catégories" styleClass="table-card-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="Double-cliquez une cellule pour la modifier · la dernière ligne vide en ajoute une · touche Suppr pour retirer"
                           wrapText="true" maxWidth="620" styleClass="form-card-sub"/>
                </HBox>
                <TableView fx:id="tableCategories" editable="true" styleClass="table-embed"
                           VBox.vgrow="ALWAYS" minHeight="240">
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colonneNom" text="Nom" prefWidth="250"/>
                        <TableColumn fx:id="colonneType" text="Type" prefWidth="150"/>
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>
</BorderPane>
