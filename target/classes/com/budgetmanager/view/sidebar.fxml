<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="sidebar-pill" alignment="TOP_CENTER" spacing="10"
      xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.budgetmanager.controller.SidebarController">

    <Button fx:id="boutonDashboard" styleClass="nav-circle" onAction="#allerVersDashboard"
            contentDisplay="GRAPHIC_ONLY"/>
    <Button fx:id="boutonRevenus" styleClass="nav-circle" onAction="#allerVersRevenus"
            contentDisplay="GRAPHIC_ONLY"/>
    <Button fx:id="boutonDepenses" styleClass="nav-circle" onAction="#allerVersDepenses"
            contentDisplay="GRAPHIC_ONLY"/>
    <Button fx:id="boutonEconomies" styleClass="nav-circle" onAction="#allerVersEconomies"
            contentDisplay="GRAPHIC_ONLY"/>
    <Button fx:id="boutonCategories" styleClass="nav-circle" onAction="#allerVersCategories"
            contentDisplay="GRAPHIC_ONLY"/>
    <Button fx:id="boutonHistorique" styleClass="nav-circle" onAction="#allerVersHistorique"
            contentDisplay="GRAPHIC_ONLY"/>
    <Button fx:id="boutonStatistiques" styleClass="nav-circle" onAction="#allerVersStatistiques"
            contentDisplay="GRAPHIC_ONLY"/>
    <Button fx:id="boutonParametres" styleClass="nav-circle" onAction="#allerVersParametres"
            contentDisplay="GRAPHIC_ONLY"/>

    <Region VBox.vgrow="ALWAYS"/>

    <Button fx:id="boutonDeconnexion" styleClass="nav-circle,nav-circle-logout" onAction="#seDeconnecter"
            contentDisplay="GRAPHIC_ONLY"/>
</VBox>
