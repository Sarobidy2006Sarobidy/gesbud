<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
  Récupération de compte en 3 étapes, dans la même carte glassmorphism
  que la connexion. Le contenu défile : l'étape 3 est plus haute que l'écran.
-->
<StackPane fx:id="racine" styleClass="auth-container" alignment="TOP_LEFT" xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.budgetmanager.controller.ForgotPasswordController">
    <HBox>
        <fx:include source="auth-hero.fxml" HBox.hgrow="ALWAYS"/>

        <StackPane styleClass="auth-side" minWidth="620" prefWidth="720" HBox.hgrow="ALWAYS">
            <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" styleClass="auth-scroll">
                <StackPane styleClass="auth-scroll-content">
                    <!-- maxHeight=-Infinity : sans lui, la carte s'étire sur toute la
                         hauteur du ScrollPane et laisse un vide sous le contenu. -->
                    <VBox styleClass="auth-card-premium" spacing="16" maxWidth="520" maxHeight="-Infinity" alignment="TOP_CENTER">

                        <!-- Logo + marque -->
                        <HBox alignment="CENTER_LEFT" spacing="14">
                            <StackPane fx:id="zoneLogo"/>
                            <VBox spacing="1">
                                <Label text="BUDGET PERSONNEL" styleClass="auth-brand-premium"/>
                                <Label text="Récupération de compte" styleClass="auth-brand-sub"/>
                            </VBox>
                        </HBox>

                        <VBox spacing="5">
                            <Label text="Mot de passe oublié" styleClass="auth-title-premium"/>
                            <Label text="Répondez à votre question de sécurité pour choisir un nouveau mot de passe"
                                   styleClass="auth-tagline-premium" wrapText="true"/>
                        </VBox>

                        <!-- Indicateur des 3 étapes -->
                        <HBox alignment="CENTER" spacing="8">
                            <Label fx:id="pastille1" text="1" styleClass="auth-step"/>
                            <Region styleClass="auth-step-line" HBox.hgrow="ALWAYS"/>
                            <Label fx:id="pastille2" text="2" styleClass="auth-step"/>
                            <Region styleClass="auth-step-line" HBox.hgrow="ALWAYS"/>
                            <Label fx:id="pastille3" text="3" styleClass="auth-step"/>
                        </HBox>

                        <Label fx:id="labelMessage" styleClass="auth-message" wrapText="true" maxWidth="Infinity"/>

                        <!-- Étape 1 : email -->
                        <VBox fx:id="panneauEmail" spacing="14">
                            <Label text="Saisissez le pseudo ou l'adresse email de votre compte."
                                   styleClass="auth-step-hint" wrapText="true"/>
                            <VBox spacing="6">
                                <Label text="IDENTIFIANT" styleClass="auth-field-label"/>
                                <HBox styleClass="auth-input-premium" alignment="CENTER_LEFT">
                                    <StackPane fx:id="zoneIconeEmail" styleClass="auth-input-icon-premium"/>
                                    <TextField fx:id="champEmail" styleClass="auth-textfield-premium"
                                               promptText="Pseudo ou adresse email"
                                               HBox.hgrow="ALWAYS" onAction="#continuer"/>
                                </HBox>
                            </VBox>
                            <Button fx:id="boutonContinuer" text="CONTINUER" styleClass="auth-button-premium"
                                    maxWidth="Infinity" onAction="#continuer"/>
                        </VBox>

                        <!-- Étape 2 : question de sécurité -->
                        <VBox fx:id="panneauQuestion" spacing="14">
                            <Label text="Votre question de sécurité" styleClass="auth-step-hint"/>
                            <Label fx:id="labelQuestion" styleClass="auth-question" wrapText="true" maxWidth="Infinity"/>
                            <VBox spacing="6">
                                <Label text="VOTRE RÉPONSE" styleClass="auth-field-label"/>
                                <HBox styleClass="auth-input-premium" alignment="CENTER_LEFT">
                                    <StackPane fx:id="zoneIconeReponse" styleClass="auth-input-icon-premium"/>
                                    <TextField fx:id="champReponse" styleClass="auth-textfield-premium"
                                               promptText="Votre réponse"
                                               HBox.hgrow="ALWAYS" onAction="#verifierReponse"/>
                                </HBox>
                            </VBox>
                            <Button fx:id="boutonVerifier" text="VÉRIFIER MA RÉPONSE" styleClass="auth-button-premium"
                                    maxWidth="Infinity" onAction="#verifierReponse"/>
                        </VBox>

                        <!-- Étape 3 : nouveau mot de passe -->
                        <VBox fx:id="panneauMotDePasse" spacing="14">
                            <Label text="Choisissez votre nouveau mot de passe (8 caractères minimum)."
                                   styleClass="auth-step-hint" wrapText="true"/>
                            <VBox spacing="6">
                                <Label text="NOUVEAU MOT DE PASSE" styleClass="auth-field-label"/>
                                <HBox styleClass="auth-input-premium" alignment="CENTER_LEFT">
                                    <StackPane fx:id="zoneIconeNouveau" styleClass="auth-input-icon-premium"/>
                                    <PasswordField fx:id="champNouveauMotDePasse" styleClass="auth-textfield-premium"
                                                   promptText="••••••••" HBox.hgrow="ALWAYS"/>
                                </HBox>
                            </VBox>
                            <VBox spacing="6">
                                <Label text="CONFIRMATION" styleClass="auth-field-label"/>
                                <HBox styleClass="auth-input-premium" alignment="CENTER_LEFT">
                                    <StackPane fx:id="zoneIconeConfirmation" styleClass="auth-input-icon-premium"/>
                                    <PasswordField fx:id="champConfirmation" styleClass="auth-textfield-premium"
                                                   promptText="••••••••" HBox.hgrow="ALWAYS"
                                                   onAction="#enregistrerNouveauMotDePasse"/>
                                </HBox>
                            </VBox>
                            <Button fx:id="boutonEnregistrer" text="CHANGER LE MOT DE PASSE"
                                    styleClass="auth-button-premium"
                                    maxWidth="Infinity" onAction="#enregistrerNouveauMotDePasse"/>
                        </VBox>

                        <VBox alignment="CENTER" spacing="2">
                            <Label text="Un doute ?" styleClass="auth-footer-text-premium"/>
                            <Hyperlink fx:id="lienRetour" text="Retour à la connexion" styleClass="auth-link-register"
                                       onAction="#allerVersConnexion"/>
                        </VBox>

                    </VBox>
                </StackPane>
            </ScrollPane>
        </StackPane>
    </HBox>
</StackPane>
