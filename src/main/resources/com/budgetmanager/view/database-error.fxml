<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
  Écran de secours quand MySQL est injoignable : carte verre sur le fond
  dégradé, comme les autres pages d'authentification.
-->
<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.budgetmanager.controller.DatabaseErrorController"
           styleClass="auth-container">

    <VBox alignment="CENTER" spacing="12" maxWidth="560" maxHeight="-Infinity"
          styleClass="auth-card-premium, auth-card-compact">

        <StackPane fx:id="iconeErreur" alignment="CENTER" styleClass="erreur-icone"/>

        <Label fx:id="labelTitre" text="Base de données inaccessible"
               styleClass="auth-title-premium" wrapText="true" alignment="CENTER"/>

        <Label fx:id="labelDetail" styleClass="erreur-detail"
               wrapText="true" alignment="CENTER" maxWidth="440"/>

        <Label fx:id="labelPort" styleClass="erreur-port"
               wrapText="true" alignment="CENTER" maxWidth="440"/>

        <!-- Guide rapide -->
        <VBox spacing="6" styleClass="auth-security-row" maxWidth="480">
            <Label text="Ce qu'il faut faire :" styleClass="erreur-guide-titre"/>
            <Label text="1. Ouvrez XAMPP (ou WampServer), le petit panneau qui démarre vos programmes"
                   styleClass="erreur-guide-pas" wrapText="true"/>
            <Label text="2. Cliquez sur « Start » en face de MySQL, puis attendez que la ligne devienne colorée"
                   styleClass="erreur-guide-pas" wrapText="true"/>
            <Label text="3. Si le numéro de port affiché par XAMPP diffère de celui indiqué ci-dessus, ouvrez le fichier database.properties (dans le dossier de l'application) et remplacez-y ce numéro"
                   styleClass="erreur-guide-pas" wrapText="true"/>
            <Label text="4. Revenez ici et cliquez sur « Réessayer » : l'application se reconnecte sans redémarrer"
                   styleClass="erreur-guide-pas" wrapText="true"/>
        </VBox>

        <Label fx:id="labelStatut" styleClass="erreur-statut"
               wrapText="true" alignment="CENTER" maxWidth="440"
               visible="false" managed="false"/>

        <HBox spacing="12" alignment="CENTER">
            <Button fx:id="boutonReessayer" text="Réessayer"
                    styleClass="auth-button-premium, bouton-reessayer" onAction="#reessayer"/>
            <Button fx:id="boutonQuitter" text="Quitter"
                    styleClass="auth-button-ghost, bouton-quitter" onAction="#quitter"/>
        </HBox>

    </VBox>
</StackPane>
