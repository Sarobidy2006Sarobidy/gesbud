<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Panneau décoratif de gauche des écrans d'authentification : badges hexagonaux
     flottants (dessinés en Java par AuthHeroController) + accroche.
     minWidth="0" : la fenêtre peut descendre à 920 px, et le panneau de droite
     (connexion / inscription) est prioritaire — le hero se comprime au lieu
     de déborder de la scène. -->
<StackPane styleClass="auth-hero" minWidth="0" xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.budgetmanager.controller.AuthHeroController">
    <Pane fx:id="zoneHexagones" mouseTransparent="true"/>
    <VBox fx:id="blocAccroche" styleClass="auth-hero-text" minWidth="0"
          alignment="BOTTOM_LEFT" spacing="10" pickOnBounds="false">
        <Region styleClass="auth-hero-accent"/>
        <Label text="Gardez le contrôle de votre budget" styleClass="auth-hero-title" wrapText="true"/>
        <Label text="Revenus, dépenses, catégories et statistiques : tout votre suivi financier au même endroit."
               styleClass="auth-hero-subtitle" wrapText="true"/>

        <!-- Les badges sont confinés en haut du panneau : sans ces atouts, toute la
             moitié basse restait un vide bleu. Puces dessinées en Java (Icons). -->
        <VBox fx:id="blocAtouts" spacing="8" maxWidth="520" styleClass="auth-hero-atouts">
            <HBox styleClass="auth-hero-atout" alignment="CENTER_LEFT" spacing="11">
                <StackPane fx:id="puceAtout1" styleClass="auth-hero-puce"/>
                <Label text="Revenus et dépenses suivis mois par mois"
                       styleClass="auth-hero-atout-texte" wrapText="true"/>
            </HBox>
            <HBox styleClass="auth-hero-atout" alignment="CENTER_LEFT" spacing="11">
                <StackPane fx:id="puceAtout2" styleClass="auth-hero-puce"/>
                <Label text="Catégories, graphiques et taux d'épargne instantanés"
                       styleClass="auth-hero-atout-texte" wrapText="true"/>
            </HBox>
            <HBox styleClass="auth-hero-atout" alignment="CENTER_LEFT" spacing="11">
                <StackPane fx:id="puceAtout3" styleClass="auth-hero-puce"/>
                <Label text="Vos données restent chiffrées sur votre machine"
                       styleClass="auth-hero-atout-texte" wrapText="true"/>
            </HBox>
        </VBox>
    </VBox>
</StackPane>
