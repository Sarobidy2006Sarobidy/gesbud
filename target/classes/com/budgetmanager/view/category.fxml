<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="background-page" xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.budgetmanager.controller.CategoryController">

    <left>
        <fx:include fx:id="sidebar" source="sidebar.fxml"/>
    </left>

    <center>
        <VBox spacing="16" styleClass="page-content, page-content-flat">
            <Label text="Gestion des catégories" styleClass="page-title"/>

            <VBox styleClass="card" spacing="12">
                <Label text="Ajouter / Modifier une catégorie" styleClass="card-title"/>
                <HBox spacing="12">
                    <TextField fx:id="champNom" promptText="Nom de la catégorie" HBox.hgrow="ALWAYS"/>
                    <ComboBox fx:id="comboType" promptText="Type" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                </HBox>
                <HBox spacing="10">
                    <Button fx:id="boutonAjouter" text="Ajouter" styleClass="button-primary" onAction="#ajouterCategorie" contentDisplay="LEFT"/>
                    <Button fx:id="boutonModifier" text="Modifier" styleClass="button-secondary" onAction="#modifierCategorie" contentDisplay="LEFT"/>
                    <Button fx:id="boutonSupprimer" text="Supprimer" styleClass="button-danger" onAction="#supprimerCategorie" contentDisplay="LEFT"/>
                </HBox>
            </VBox>

            <TableView fx:id="tableCategories" VBox.vgrow="ALWAYS" minHeight="220">
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colonneNom" text="Nom" prefWidth="250"/>
                    <TableColumn fx:id="colonneType" text="Type" prefWidth="150"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
